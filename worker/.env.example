# Jetons PARTAGÉS avec l'API HostBuster (Abeille) — doivent être IDENTIQUES des deux côtés.
WORKER_API_TOKEN=
WORKER_CALLBACK_TOKEN=

# Où sont stockées les instances
WORKER_CLIENTS_DIR=/root/clients

# Domaine racine des instances (sous-domaines aléatoires en dessous)
WORKER_BASE_DOMAIN=cpi-corporation.filiere.info

# Plage de ports hôte allouée aux instances
WORKER_PORT_START=20000
WORKER_PORT_END=30000

# Hôte public de Lion (pour l'accès Minecraft <hôte>:<port> et lien de secours).
# Mets l'IP/hostname public de la VM Lion.
WORKER_PUBLIC_HOST=

# Adresse d'écoute de l'agent. 127.0.0.1 = local seulement.
# Pour un accès direct depuis Abeille : mets l'IP privée/IPv6 de Lion
# joignable par Abeille (ou 0.0.0.0 si tu filtres le port 8088 au firewall).
WORKER_BIND=127.0.0.1
